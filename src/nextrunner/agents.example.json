{
  "agent-a": {
    "cmd": [
      "agent-a-cli",
      "run",
      "--dir",
      "{cwd}",
      "--sandbox",
      "read-only",
      "--write-reply-to",
      "{out}",
      "{prompt}"
    ],
    "cmd_edit": [
      "agent-a-cli",
      "run",
      "--dir",
      "{cwd}",
      "--sandbox",
      "write",
      "--also-writable",
      "{board}",
      "--write-reply-to",
      "{out}",
      "{prompt}"
    ],
    "reply": "file"
  },
  "agent-b": {
    "cmd": [
      "agent-b-cli",
      "--print",
      "{prompt}",
      "--output-format",
      "json",
      "--allow",
      "read"
    ],
    "reply": "json:result",
    "session": "\"session_id\":\\s*\"([^\"]+)\"",
    "cmd_resume": [
      "agent-b-cli",
      "--print",
      "{prompt}",
      "--output-format",
      "json",
      "--allow",
      "read",
      "--resume",
      "{session}"
    ]
  },
  "agent-c": {
    "cmd": [
      "agent-c-cli",
      "{prompt}"
    ],
    "reply": "stdout"
  }
}
