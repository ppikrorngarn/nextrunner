{
  "agent-a": {
    "cmd": [
      "agent-a-cli",
      "run",
      "--dir",
      "{cwd}",
      "--sandbox",
      "read-only",
      "--write-reply-to",
      "{out}",
      "{prompt}"
    ],
    "cmd_edit": [
      "agent-a-cli",
      "run",
      "--dir",
      "{cwd}",
      "--sandbox",
      "write",
      "--also-writable",
      "{board}",
      "--write-reply-to",
      "{out}",
      "{prompt}"
    ],
    "reply": "file"
  },
  "agent-c": {
    "cmd": [
      "agent-c-cli",
      "{prompt}"
    ],
    "reply": "stdout"
  }
}
